# Local default. For cloud deployment replace with your Supabase PostgreSQL connection string.
DATABASE_URL=sqlite:///./life_agent_v11.db

# Public frontend URL(s), comma-separated. Example:
# FRONTEND_ORIGINS=https://your-life-agent.vercel.app
FRONTEND_ORIGINS=http://localhost:3000

# Optional real AI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VISION_MODEL=

# Bootstrap admin. Use a strong password in deployment settings; never commit a real password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Life Agent Admin
